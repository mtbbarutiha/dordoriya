generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  telegramId     BigInt    @unique
  username       String?
  firstName      String?
  /// نام نمایشی داخل دوردوریا
  displayName    String?
  bio            String?
  diamonds       Int       @default(0)
  referralCode   String    @unique
  anonCode       String    @unique
  referredById   Int?
  referredBy     User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals      User[]    @relation("Referrals")
  latitude       Float?
  longitude      Float?
  locationAt     DateTime?
  /// female | male
  gender         String?
  /// female | male | any
  lookingFor     String?
  age            Int?
  city           String?
  photoFileId    String?
  /// آیا ثبت‌نام کامل شده
  registered     Boolean   @default(false)
  /// gender | age | name | looking | done | idle | waiting | chatting | await_anon_msg | await_location | explore
  state          String    @default("gender")
  pendingAnonTo  String?
  chatPartnerId  Int?
  boostUntil     DateTime?
  isPro          Boolean   @default(false)
  viewsCount     Int       @default(0)
  likesCount     Int       @default(0)
  chatsCount     Int       @default(0)
  lastActiveAt   DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  diamondOrders  DiamondOrder[]
  anonInbox      AnonMessage[]  @relation("AnonTo")
  anonSent       AnonMessage[]  @relation("AnonFrom")
  exploreSeen    ExploreSeen[]  @relation("Viewer")
  exploreShown   ExploreSeen[]  @relation("Shown")
}

model ExploreSeen {
  id         Int  @id @default(autoincrement())
  viewerId   Int
  shownId    Int
  viewer     User @relation("Viewer", fields: [viewerId], references: [id])
  shown      User @relation("Shown", fields: [shownId], references: [id])

  @@unique([viewerId, shownId])
}

model DiamondOrder {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  packageId   String
  diamonds    Int
  amountToman Int
  status      String   @default("pending")
  paymentCode String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnonMessage {
  id         Int      @id @default(autoincrement())
  toUserId   Int
  toUser     User     @relation("AnonTo", fields: [toUserId], references: [id])
  fromUserId Int?
  fromUser   User?    @relation("AnonFrom", fields: [fromUserId], references: [id])
  text       String
  createdAt  DateTime @default(now())
}
